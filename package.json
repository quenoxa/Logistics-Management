{
  "name": "logistics-one",
  "version": "1.0.0",
  "private": true,
  "description": "LOGISTICS ONE — Enterprise Logistics & Fleet Management Operations Platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "nodemon --watch src/server --exec ts-node -P tsconfig.server.json src/server/server.ts",
    "build": "tsc && vite build",
    "start": "ts-node -P tsconfig.server.json src/server/server.ts",
    "preview": "vite preview",
    "db:push": "prisma db push",
    "db:seed": "ts-node -P tsconfig.server.json prisma/seed.ts",
    "db:generate": "prisma generate",
    "test:suite": "ts-node -P tsconfig.server.json src/server/test-suite.ts",
    "test:audit": "ts-node -P tsconfig.server.json src/server/audit-runner.ts",
    "test:smoke": "ts-node -P tsconfig.server.json src/server/smoke-test-runner.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
