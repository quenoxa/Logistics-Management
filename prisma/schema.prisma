datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // passwordHash
  name      String
  role      String   @default("DISPATCHER") // ADMIN, DISPATCHER, DRIVER, VIEWER
  phone     String?
  avatar    String?
  isActive  Boolean  @default(true)
  status    String   @default("ACTIVE")     // ACTIVE, INACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver    Driver?
  auditLogs AuditLog[]
}

model Vehicle {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  code                String           @unique // e.g. FL-8021
  vehicleNumber       String           @default("")
  vin                 String           @unique
  make                String           @default("Freightliner")
  manufacturer        String           @default("Freightliner")
  model               String
  year                Int              @default(2024)
  licensePlate        String           @unique
  type                String           // BOX_TRUCK, SPRINTER_VAN, SEMI_TRAILER, EV_VAN, REEFER_TRUCK
  capacity            Float            @default(1000.0) // maxPayloadKg
  maxPayloadKg        Float            @default(1000.0)
  maxVolumeM3         Float            @default(20.0)
  fuelType            String           @default("DIESEL")
  currentFuelPercent  Float            @default(100.0)
  currentMileageKm    Float            @default(0.0)
  mileage             Float            @default(0.0)
  status              String           @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_TRANSIT, MAINTENANCE, INACTIVE, ACTIVE, IDLE, OUT_OF_SERVICE
  currentLatitude     Float?
  currentLongitude    Float?
  currentLat          Float?
  currentLng          Float?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  lastServiceDate     DateTime?
  nextServiceDueKm    Float?
  assignedDriverId    String?          @unique @db.ObjectId
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  assignedDriver      Driver?          @relation(fields: [assignedDriverId], references: [id])
  maintenanceLogs     MaintenanceLog[]
  deliveries          Delivery[]
}

model MaintenanceLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId       String    @db.ObjectId
  type            String    @default("PREVENTATIVE")
  serviceType     String    @default("PREVENTATIVE")
  description     String
  cost            Float
  maintenanceDate DateTime  @default(now())
  nextDueDate     DateTime?
  serviceDate     DateTime  @default(now())
  odometerKm      Float     @default(0.0)
  performedBy     String?
  status          String    @default("COMPLETED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Driver {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?   @unique @db.ObjectId
  code              String    @unique // e.g. DRV-104
  firstName         String
  lastName          String
  email             String    @unique
  phone             String
  licenseNumber     String    @unique
  licenseClass      String    @default("CDL_A")
  licenseExpiry     DateTime
  status            String    @default("AVAILABLE") // AVAILABLE, ON_DELIVERY, OFF_DUTY, SUSPENDED, ON_LEAVE
  currentLatitude   Float?
  currentLongitude  Float?
  rating            Float     @default(5.0)
  totalDeliveries   Int       @default(0)
  onTimeRatePercent Float     @default(98.5)
  emergencyContact  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User?     @relation(fields: [userId], references: [id])
  currentVehicle    Vehicle?
  deliveries        Delivery[]
  issues            Issue[]
}

model Order {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String    @unique // e.g. ORD-2026-9041
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  weightKg        Float
  volumeM3        Float
  cargoType       String    @default("GENERAL_FREIGHT")
  priority        String    @default("STANDARD")
  status          String    @default("PENDING")
  deliveryFee     Float     @default(0.0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  delivery        Delivery?
}

model Delivery {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  trackingNumber        String                  @unique // e.g. TRK-882910
  orderId               String?                 @unique @db.ObjectId
  customerName          String                  @default("Valued Customer")
  customerPhone         String                  @default("+1-555-0199")
  pickupAddress         String                  @default("Central Distribution Hub")
  pickupLatitude        Float                   @default(40.7128)
  pickupLongitude       Float                   @default(-74.0060)
  deliveryAddress       String                  @default("Destination Logistics Hub")
  deliveryLatitude      Float                   @default(40.7306)
  deliveryLongitude     Float                   @default(-73.9352)
  packageDescription    String                  @default("General Pallet Freight")
  packageWeight         Float                   @default(150.0)
  driverId              String?                 @db.ObjectId
  vehicleId             String?                 @db.ObjectId
  status                String                  @default("PENDING") // PENDING, ASSIGNED, ACCEPTED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, FAILED
  priority              String                  @default("STANDARD")
  pickupScheduledAt     DateTime?               @default(now())
  pickupActualAt        DateTime?
  deliveryEstimatedAt   DateTime                @default(now())
  estimatedDeliveryTime DateTime?               @default(now())
  deliveryActualAt      DateTime?
  actualDeliveryTime    DateTime?
  currentLat            Float?
  currentLng            Float?
  progressPercent       Float                   @default(0.0)
  routeDistanceKm       Float                   @default(0.0)
  routeDurationMin      Int                     @default(0)
  recipientSignature    String?
  delayReason           String?
  notes                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  order                 Order?                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver                Driver?                 @relation(fields: [driverId], references: [id])
  vehicle               Vehicle?                @relation(fields: [vehicleId], references: [id])
  timelineEvents        DeliveryTimelineEvent[]
  statusHistory         DeliveryStatusHistory[]
  issues                Issue[]
}

model DeliveryTimelineEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  deliveryId   String   @db.ObjectId
  status       String
  title        String
  description  String
  locationName String?
  lat          Float?
  lng          Float?
  recordedAt   DateTime @default(now())
  recordedBy   String?

  delivery     Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryStatusHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  deliveryId String   @db.ObjectId
  status     String
  note       String?
  latitude   Float?
  longitude  Float?
  timestamp  DateTime @default(now())
  updatedBy  String?

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  deliveryId  String?   @db.ObjectId
  driverId    String?   @db.ObjectId
  type        String    // MECHANICAL, TRAFFIC, WEATHER, RECIPIENT_UNAVAILABLE, DAMAGED, OTHER
  description String
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  delivery    Delivery? @relation(fields: [deliveryId], references: [id])
  driver      Driver?   @relation(fields: [driverId], references: [id])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       String   @default("System")
  userName   String   @default("System")
  action     String
  entity     String   @default("SYSTEM")
  entityType String   @default("SYSTEM")
  entityId   String?
  metadata   String?
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  userRef    User?    @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}
